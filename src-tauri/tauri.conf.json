{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetOnMe",
  "version": "0.1.0",
  "identifier": "com.betonme.daily",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "BetOnMe",
        "width": 480,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.js": "server.js",
      "../node_modules/express": "node_modules/express",
      "../node_modules/cors": "node_modules/cors"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "nodejs"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}